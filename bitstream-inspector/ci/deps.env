# Pinned third-party dependencies used by CI and the Windows package.
# Update this file together with the installer DLL names, BUILD-INFO.txt and
# the FFmpeg build configuration; scripts/check_dependencies.py watches
# upstream releases and opens a tracking issue when a newer version exists.

FFMPEG_VERSION=9.1
FFMPEG_SHA256=1a4d394ae63d190a526cd052eb4415c156b5c5e2df37efab41a7de0b8fde2433

# Installer toolchain floor. The CI runner installs NSIS from its pinned
# Ubuntu image, so this records what the installer was tested with.
NSIS_MIN_VERSION=3.09
